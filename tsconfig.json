{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ds/*": ["design_system/*"],
      "@core": ["src/core/index.ts"],
      "@core/*": ["src/core/*"],
      "@app/*": ["src/app/*"],
      "@modules/*": ["src/modules/*"]
    }
  },
  "include": ["src", "design_system", "tests"]
}

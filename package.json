{
  "name": "humanitta-design-system",
  "private": true,
  "version": "1.0.0",
  "description": "Humanittá Gestão — base multiagente (design system + arquitetura compartilhada, demonstração)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "verify": "npm run typecheck && npm test && vite build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "agents:worktrees": "node scripts/setup-worktrees.mjs",
    "test:e2e": "playwright test",
    "pages:serve": "node scripts/serve-pages.mjs",
    "verify:full": "npm run verify && npm run test:e2e",
    "demo:check": "playwright test -c playwright.published.config.ts tests/e2e/demo-script.spec.ts --project=desktop",
    "demo:check:full": "playwright test -c playwright.published.config.ts"
  },
  "dependencies": {
    "lucide-react": "0.441.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
